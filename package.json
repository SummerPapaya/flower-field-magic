{
  "name": "flower-field-magic",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "A web camera where a tap or a swipe makes a field of flowers bloom around you, planted in place with AR. 花田魔法：点一下、滑一道，花就在你身边开成一片花田。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:lab": "tsc -p tsconfig.json && vite build --mode lab",
    "preview": "vite preview",
    "preview:lab": "vite preview --mode lab",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
